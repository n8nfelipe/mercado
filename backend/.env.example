PORT=8080
ADDR=127.0.0.1:8080
DATABASE_URL=postgres://mercado:change-me@127.0.0.1:5432/mercado?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
SERVICE_NAME=mercado-api
SERVICE_VERSION=dev
GIT_COMMIT=none
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
READ_HEADER_TIMEOUT=5s
READINESS_TIMEOUT=2s
MAX_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_API_KEY_PER_MINUTE=600
RATE_LIMIT_WINDOW=1m
TRUST_PROXY=true
SESSION_COOKIE_NAME=mercado_session
SESSION_TTL=168h
SESSION_SECURE=false
ALLOWED_ORIGINS=http://mercado.localhost:8080,http://127.0.0.1:3000,http://localhost:3000
LOGIN_RATE_LIMIT_PER_MINUTE=10
MINIO_ENDPOINT=127.0.0.1:15434
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mercado-listings
MINIO_USE_SSL=false

# Seed de catálogo (opcional). Sem estas variáveis o seed cria apenas categorias.
SEED_SELLER_EMAIL=
SEED_SELLER_PASSWORD=
SEED_SELLER_NAME=
SEED_BUYER_EMAIL=
SEED_BUYER_PASSWORD=
SEED_BUYER_NAME=
